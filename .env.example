# =============================================================================
# RYME — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Do NOT commit the .env file to version control.

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local-only placeholder (NOT a credential): replace with your own value and
# never reuse it outside this machine's Docker network.
DATABASE_URL="postgresql://ryme:change_me_local_dev_password@localhost:5432/ryme?schema=public"
POSTGRES_USER=ryme
POSTGRES_PASSWORD=change_me_local_dev_password
POSTGRES_DB=ryme

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# Path to Docker socket (Linux/WSL2 default)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Docker network for deployed containers and Traefik
DOCKER_NETWORK=ryme-network

# Image prefix for built images
DOCKER_IMAGE_PREFIX=ryme

# -----------------------------------------------------------------------------
# Port Allocation
# -----------------------------------------------------------------------------
PORT_RANGE_START=10000
PORT_RANGE_END=65000

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# Directory for cloned repositories (relative to backend root)
WORKSPACE_DIR=../../data/workspaces

# Maximum build time in milliseconds (10 minutes)
BUILD_TIMEOUT_MS=600000

# Domain suffix for deployed apps
DEPLOY_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Traefik
# -----------------------------------------------------------------------------
TRAEFIK_DASHBOARD_PORT=8080

# -----------------------------------------------------------------------------
# GitHub OAuth
# -----------------------------------------------------------------------------
# Create a GitHub OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3001/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# -----------------------------------------------------------------------------
# GitHub PAT (Personal Access Token) — required for dev login
# -----------------------------------------------------------------------------
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_TOKEN=your_github_personal_access_token

# -----------------------------------------------------------------------------
# GitHub PAT (Development Login)
# -----------------------------------------------------------------------------
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_TOKEN=your_github_personal_access_token

# -----------------------------------------------------------------------------
# Development-only login bypass (POST /api/v1/dev/login)
# -----------------------------------------------------------------------------
# Fail-closed: the endpoint is enabled only when BOTH conditions are true:
#   NODE_ENV=development   AND   ENABLE_DEV_LOGIN=true
# Production (NODE_ENV=production) can never enable it. Default: disabled.
ENABLE_DEV_LOGIN=false

# -----------------------------------------------------------------------------
# JWT / Auth
# -----------------------------------------------------------------------------
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_32_char_string
JWT_EXPIRES_IN=24h

# Frontend URL for OAuth redirect
FRONTEND_URL=http://localhost:5173

# Key for encrypting GitHub access tokens in the database (32+ chars)
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=change_me_to_a_random_32_char_string
