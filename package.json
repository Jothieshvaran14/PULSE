{
  "name": "ryme",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted open-source deployment platform",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -r --if-present --parallel dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @ryme/db db:generate",
    "db:migrate": "pnpm --filter @ryme/db db:migrate",
    "db:migrate:prod": "pnpm --filter @ryme/db db:migrate:prod",
    "db:seed": "pnpm --filter @ryme/db db:seed",
    "db:studio": "pnpm --filter @ryme/db db:studio",
    "db:reset": "pnpm --filter @ryme/db db:reset",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ryme/backend test && node tests/test-dev-gate.mjs && node apps/backend/node_modules/tsx/dist/cli.mjs tests/repro-traefik-roundtrip.mjs",
    "test:integration": "node apps/backend/node_modules/tsx/dist/cli.mjs tests/test-api-regressions.mjs && node apps/backend/node_modules/tsx/dist/cli.mjs tests/repro-idor.mjs",
    "test:repro": "node tests/test-dev-gate.mjs",
    "clean": "pnpm -r clean && rimraf node_modules",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "infra:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
